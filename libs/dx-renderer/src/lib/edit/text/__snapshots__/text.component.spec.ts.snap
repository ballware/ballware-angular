exports[`EditLayoutTextComponent should create mail 1`] = `
<ballware-edit-text
  allowScanner="false"
  destroy={[Function Destroy]}
  fullscreenDialogs$={[Function Observable]}
  livecycle={[Function EditItemLivecycle]}
  onScannerCancel={[Function Function]}
  onScannerClicked={[Function Function]}
  readonly={[Function Readonly]}
  responsiveService={[Function ]}
  showScanner="false"
  validation={[Function Validation]}
  value={[Function StringValue]}
  visible={[Function Visible]}
>
  <dx-text-box
    class="mt-2 dx-validator dx-visibility-change-handler dx-show-invalid-badge dx-textbox dx-texteditor dx-editor-outlined dx-texteditor-empty dx-widget"
  >
    <div
      class="dx-texteditor-container"
    >
      <div
        class="dx-texteditor-input-container"
      >
        <input
          autocomplete="off"
          class="dx-texteditor-input"
          name="mockedmember"
