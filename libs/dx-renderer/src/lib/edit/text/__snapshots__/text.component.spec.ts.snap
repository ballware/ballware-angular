              class="dx-icon bi bi-qr-code-scan"
            />
          </div>
        </div>
      </div>
    </div>
  </dx-text-box><dx-popup
    class="dx-overlay dx-popup dx-widget dx-state-invisible dx-visibility-change-handler"
    height="auto"
    maxheight="90vh"
    minwidth="500px"
    width="auto"
  >
    <div
      class="dx-overlay-content dx-popup-fullscreen-width dx-popup-normal"
