      >
        <div
          aria-hidden="true"
          aria-label="bi bi-qr-code-scan"
          class="dx-widget dx-button dx-button-mode-contained dx-button-normal dx-button-has-icon dx-state-invisible"
          role="button"
          tabindex="0"
        >
          <div
