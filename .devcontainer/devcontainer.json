// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/typescript-node
{
	"name": "Node.js & TypeScript",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/typescript-node:20-bookworm",

	"workspaceMount": "source=${localWorkspaceFolderBasename}-ws,target=/workspaces/${localWorkspaceFolderBasename},type=volume",
  	"workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

	"remoteUser": "node",

	// Features to add to the dev container. More info: https://containers.dev/features.
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:2": {}
	},
	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// ensure Anular opens at localhost and not 127.0.0.1
	"forwardPorts": [3000, "localhost:3000", 4200, "localhost:4200"],
	"postCreateCommand": "bash -lc 'sudo chown -R $(id -u):$(id -g) . && shopt -s dotglob && if [ -z \"$(ls -A .)\" ]; then git clone --depth 1 \"$REPO_URL\" .; fi && yarn install'",

	"containerEnv": {
		"REPO_URL": "https://github.com/ballware/ballware-angular.git",
		"NODE_OPTIONS": "--max-old-space-size=16384"
	},
	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			"extensions": [
				"angular.ng-template",
				//"nrwl.angular-console",
				"esbenp.prettier-vscode",
				"dbaeumer.vscode-eslint",
				"firsttris.vscode-jest-runner",
				"ryanluker.vscode-coverage-gutters"
			],
			"settings": {
				"editor.codeActionsOnSave": {
					"source.organizeImports": true,
					"source.fixAll": true
				},
				"editor.formatOnSave": true
			}
		}
	}

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}