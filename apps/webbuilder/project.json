{
  "name": "webbuilder",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/webbuilder/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular-builders/custom-webpack:browser",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/webbuilder",
        "index": "apps/webbuilder/src/index.html",
        "main": "apps/webbuilder/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/webbuilder/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "apps/webbuilder/src/favicon.ico",
          "apps/webbuilder/src/assets"
        ],
        "styles": [
          "node_modules/bootstrap/scss/bootstrap-grid.scss",
          "node_modules/bootstrap/scss/bootstrap-utilities.scss",
          "node_modules/bootstrap/scss/bootstrap-reboot.scss",
          "node_modules/bootstrap-icons/font/bootstrap-icons.scss",
          "node_modules/devextreme/dist/css/dx.material.blue.light.css",
          "apps/webbuilder/src/styles.scss"
        ],
        "scripts": [],
        "indexTransform": "apps/webbuilder/index-html-transform.ts"
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "4kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "webbuilder:build:production"
        },
        "development": {
          "buildTarget": "webbuilder:build:development"
        }
      },
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "webbuilder:build",
        "host": "localhost",
        "port": 3000,
        "ssl": true,
        "sslKey": "localhost-key.pem",
        "sslCert": "localhost.pem"
      }
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "webbuilder:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/webbuilder/jest.config.ts"
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "webbuilder:build",
        "port": 3000,
        "spa": true
      }
    }
  }
}
